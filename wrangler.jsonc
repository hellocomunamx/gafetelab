{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lagafeteria",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "lagafeteria"
    }
  ],
  "observability": { "enabled": true },
  // El dominio debe estar en la misma cuenta de Cloudflare. Los registros de
  // correo (MX, SPF, DKIM) no se tocan: esto solo agrega el sitio.
  "routes": [
    { "pattern": "lagafeteria.com", "custom_domain": true },
    { "pattern": "www.lagafeteria.com", "custom_domain": true }
  ]
}
