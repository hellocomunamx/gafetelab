# Copia este archivo como .env.local y llena los valores.

# Para desarrollo. Los valores del sitio publicado viven en .env.production.

# URL pública del sitio (canónicas, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pon "true" para que ningún buscador indexe (pruebas o vista previa).
NEXT_PUBLIC_NOINDEX=

# Verificación de Google Search Console y Bing Webmaster Tools (opcional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (solo servidor; en Cloudflare: `wrangler secret put SUPABASE_SECRET_KEY`).
# La usan la fotografía en la verificación del QR, el panel de administración y los pedidos.
SUPABASE_SECRET_KEY=
# Inicio de sesión con cuenta externa, separados por coma: google, azure (Microsoft).
# Deja vacío para ofrecer solo liga y código por correo. Cada uno se activa antes en Supabase.
NEXT_PUBLIC_AUTH_PROVEEDORES=

# Stripe (solo servidor; en Cloudflare: `wrangler secret put STRIPE_SECRET_KEY` y `STRIPE_WEBHOOK_SECRET`).
# Llave restringida (rk_...) con escritura en Checkout Sessions, Customers y PaymentIntents.
STRIPE_SECRET_KEY=
# Secreto de firma (whsec_...) del webhook que apunta a /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Resend (solo servidor; en Cloudflare se guarda con `wrangler secret put RESEND_API_KEY`)
RESEND_API_KEY=
# Remitente de los correos (dominio verificado en Resend). Si se omite: LaGafetería <hola@dominio>.
RESEND_FROM=

# Asistente de IA (solo servidor; en Cloudflare: `wrangler secret put ANTHROPIC_API_KEY`)
ANTHROPIC_API_KEY=

# Envia.com (solo servidor; en Cloudflare: `wrangler secret put ENVIA_API_KEY` y `ENVIA_ORIGEN`).
# Llave de producción: ship.envia.com → Desarrolladores → Acceso de API.
ENVIA_API_KEY=
# De dónde salen los paquetes, en JSON (el estado se saca solo del código postal):
# {"nombre":"…","empresa":"LaGafetería","telefono":"…","correo":"…","calle":"…","numero":"…","colonia":"…","ciudad":"Ciudad Obregón","cp":"85000"}
ENVIA_ORIGEN=
# Opcional: paqueterías a cotizar, separadas por coma. Vacío: todas las de México.
ENVIA_PAQUETERIAS=
